# Firebase Web App configuration. VITE_* values are public browser config,
# not passwords or service-account credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional public URLs for the deployed Apps Script web apps.
VITE_AUDIT_LOG_API_URL=
VITE_FEEDBACK_API_URL=
VITE_BACKUP_SPREADSHEET_URL=

# Set to true in Vercel to show the maintenance page on the deployed site.
# Leave false (or empty) locally while developing.
VITE_MAINTENANCE_MODE=false

# Show the shared TEST MODE stamp across authenticated pages

# Optional override for the maintenance animation.
# By default the app loads public/assets/maintenance.json, which is served at
# /assets/maintenance.json after Vite/Vercel deployment. Put your downloaded
# Lottie JSON file at that path, or set this variable to another local path.
# Remote GIF/image, direct Lottie JSON, and Lottie embed URLs are also supported.
VITE_MAINTENANCE_ANIMATION_URL=